{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git worktree list *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run ts:check *)",
      "Bash(npm run lint *)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(npm run check:versions *)",
      "Bash(npm ls *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx vitest run *)",
      "Bash(npx jest *)",
      "Bash(npx eslint *)",
      "Bash(node .claude/scripts/verify.mjs *)",
      "Bash(node ../.claude/scripts/verify.mjs *)",
      "Bash(node --check *)",
      "Bash(./gradlew :core:desktopTest *)",
      "Bash(./gradlew testDebugUnitTest *)",
      "Bash(./gradlew assembleDebug *)",
      "Bash(./gradlew compileDebugKotlin *)",
      "Bash(terraform -chdir=terraform validate *)",
      "Bash(terraform -chdir=terraform plan *)",
      "Bash(uv run pytest *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(npm run deploy *)",
      "Bash(npm run publish:r2 *)",
      "Bash(npm run release:r2 *)",
      "Bash(npm run tf:apply *)",
      "Bash(npm run deploy:cloudflare *)",
      "Bash(npx firebase-tools deploy *)",
      "Bash(firebase deploy *)",
      "Bash(gcloud *)",
      "Bash(terraform apply *)",
      "Bash(npx wrangler *)",
      "Bash(wrangler *)",
      "Bash(adb *)",
      "Bash(stripe *)"
    ],
    "deny": [
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Bash(terraform destroy *)",
      "Bash(*installDebug*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
